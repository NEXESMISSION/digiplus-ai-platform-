SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# The owner inbox (/admin): the address (or addresses, comma-separated) and the password
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: another chat model (default gpt-5.4) and its reasoning effort
CHAT_MODEL=
CHAT_REASONING=
PORT=3000

# Local admin only — never add these to Vercel, the app does not use them.
# They let you run SQL from this machine: npm run sql -- supabase/schema.sql
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
